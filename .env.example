# ------------------------------------------------------------------
# Super Shop Management — environment variables (copy to .env)
# NEVER commit the real .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------

# --- Backend ---------------------------------------------------------
ENVIRONMENT=development            # development | production | test
DEBUG=false

# PostgreSQL in production; SQLite is used automatically for local development if unset
DATABASE_URL=postgresql+psycopg://shop:CHANGE_ME@postgres:5432/shop

# Three independent secrets (>= 32 chars). The app refuses to start in production with the dev defaults.
SECRET_KEY=change-me-generate-a-long-random-value
JWT_SECRET=change-me-generate-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of browser origins allowed to call the API (no wildcard in production)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000     # used in password-reset links

UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MAX_UPLOAD_MB=5
AUTO_MIGRATE=true                  # dev convenience only; ignored in production (run `alembic upgrade head`)

# Rate limits (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional SMTP for password-reset emails (without it, the link is written to the server log in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-shop.example

# --- Docker Compose (postgres container) ------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shop

# --- Frontend ---------------------------------------------------------
# Public URL of the API as seen from the BROWSER. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Show the demo-account buttons on the login page (development only)
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
